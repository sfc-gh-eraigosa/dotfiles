{
  "general": {
    "vimMode": true
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "ui": {
    "theme": "Tokyo Night"
  },
  "skills": {
    "enabled": true,
    "disabled": []
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "write_file|replace|run_shell_command",
        "hooks": [
          {
            "name": "privacy-guard",
            "type": "command",
            "command": "$GEMINI_PROJECT_DIR/ai/hooks/privacy_guard.sh"
          }
        ]
      }
    ]
  }
}
