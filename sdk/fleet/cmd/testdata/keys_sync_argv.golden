sh -c 'f="$HOME/.ssh/authorized_keys"; k='\''ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFIXTUREFIXTUREFIXTUREFIXTUREFIXTUREFIXTUR me@box'\''; n='\''ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFIXTUREFIXTUREFIXTUREFIXTUREFIXTUREFIXTUR'\''; d=$(dirname "$f"); { mkdir -p "$d" && chmod 700 "$d" && touch "$f" && chmod 600 "$f"; } || exit 1; s=$(awk -v n="$n" '\''{ o = $0; sub(/\r$/, "") } /^[ \t]*#/ { if (keep) print o; next } { $1 = $1 } { if (index($0 " ", n " ") == 1) { p = 1; exit } if (index(" " $0 " ", " " n " ")) r = 1 } END { if (p) print "present"; else if (r) print "restricted" }'\'' "$f") || exit 1; if [ -n "$s" ]; then echo "$s"; exit 0; fi; if [ -s "$f" ]; then cp -p "$f" "$f.bak-STAMP" || exit 1; if [ -n "$(tail -c 1 "$f")" ]; then echo >> "$f" || exit 1; fi; fi; printf '\''%s\n'\'' "$k" >> "$f" && echo added'
sh -c 'f="$HOME/.ssh/authorized_keys"; k='\''ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFIXTUREFIXTUREFIXTUREFIXTUREFIXTUREFIXTUR me@box'\''; n='\''ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFIXTUREFIXTUREFIXTUREFIXTUREFIXTUREFIXTUR'\''; d=$(dirname "$f"); { mkdir -p "$d" && chmod 700 "$d" && touch "$f" && chmod 600 "$f"; } || exit 1; s=$(awk -v n="$n" '\''{ o = $0; sub(/\r$/, "") } /^[ \t]*#/ { if (keep) print o; next } { $1 = $1 } { if (index($0 " ", n " ") == 1) { p = 1; exit } if (index(" " $0 " ", " " n " ")) r = 1 } END { if (p) print "present"; else if (r) print "restricted" }'\'' "$f") || exit 1; if [ -n "$s" ]; then echo "$s"; exit 0; fi; if [ -s "$f" ]; then cp -p "$f" "$f.bak-STAMP" || exit 1; if [ -n "$(tail -c 1 "$f")" ]; then echo >> "$f" || exit 1; fi; fi; printf '\''%s\n'\'' "$k" >> "$f" && echo added'
